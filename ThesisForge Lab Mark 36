        values = {}
        for tab, key in zip(tabs[1:], SECTION_KEYS):
            with tab:
                values[key] = st.text_area(SECTION_LABELS[key], value=s[key], height=320)

        submitted = st.form_submit_button("💾 Apply changes", type="primary")

