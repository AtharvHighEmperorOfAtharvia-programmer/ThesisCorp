ERROR_MESSAGES = {
    "usage_limit": "AI usage limit reached. Please try again later.",
    "authentication": "Authentication failed. Please check your OpenRouter API key in the Streamlit secrets.",
    "network": "Network error. Please check your internet connection.",
    "server": "The AI service is temporarily unavailable.",
    "unknown": "An unexpected AI error occurred.",
}


def explain_ai_error(exception):
    message = str(exception).lower()
    for error_type, keywords in ERROR_TYPES.items():
        if any(keyword in message for keyword in keywords):
            return error_type
    return "unknown"


@st.cache_resource
def get_client(api_key):
    return OpenAI(
        base_url="https://openrouter.ai/api/v1",
        api_key=api_key,
        default_headers={"X-Title": "Atharvian ThesisForge Lab"},
    )


def generate_ai_text(prompt):
    """One shared function for every text-generation feature."""
    api_key = get_secret("OPENROUTER_API_KEY")
    if not api_key:
        raise ValueError("OpenRouter API key is missing: add OPENROUTER_API_KEY to the Streamlit secrets.")

    if st.session_state.get("use_brainpad") and st.session_state.get("brain_pad"):
        prompt += "\n\nBrainstorming session:\n" + format_brainpad(st.session_state.brain_pad)

    response = get_client(api_key).chat.completions.create(
        model=get_secret("OPENROUTER_MODEL", DEFAULT_MODEL),
        messages=[{"role": "user", "content": prompt}],
        temperature=0.7,
    )
    text = response.choices[0].message.content
    if not text:
        raise ValueError("The AI returned an empty response.")
    return text.strip()


def ask_ai(prompt, attempts=2):
    """Call the AI with retries. Returns the text, or None after showing an error."""
    for attempt in range(1, attempts + 1):
        try:
            return generate_ai_text(prompt)
        except Exception as exc:
            error_type = explain_ai_error(exc)
            if error_type in ("usage_limit", "authentication") or attempt == attempts:
                st.error(ERROR_MESSAGES[error_type])
                with st.expander("Technical details"):
                    st.code(str(exc))
                return None
            time.sleep(1)
    return None


