# ---------- BrainPad ----------

def apply_brainpad(data, name):
    pad = data.get("brain_pad", "") if isinstance(data, dict) else ""
    if not pad:
        raise ValueError("No 'brain_pad' found in that file.")
    st.session_state.brain_pad = pad
    st.session_state.brain_name = name
    st.session_state.use_brainpad = True


def load_brainpad():
    """Callback: load the BrainPad from an uploaded file."""
    uploaded = st.session_state.get("brain_upload")
    if uploaded is None:
        return
    try:
        apply_brainpad(json.loads(uploaded.getvalue().decode("utf-8")), uploaded.name)
        flash("success", f"BrainPad from **{uploaded.name}** loaded and enabled as AI context.")
    except Exception as exc:
        flash("error", f"Error loading project: {exc}")


def load_brainpad_from_drive(file_id, name):
    """Callback: load the BrainPad from a BrainStormAI project on Google Drive."""
    try:
        apply_brainpad(json.loads(drive_download(file_id).decode("utf-8")), name)
        flash("success", f"BrainPad from **{name}** loaded and enabled as AI context.")
    except Exception as exc:
        flash("error", f"Error loading project: {drive_error(exc)}")


def clear_brainpad():
    st.session_state.brain_pad = ""
    st.session_state.brain_name = ""
    st.session_state.use_brainpad = False
    flash("info", "BrainPad removed.")


def list_brainstorm_projects(refresh=False):
    """BrainStormAI project files on Drive, or None if the folder doesn't exist."""
    cache = st.session_state.get("_brain_list")
    if cache is None or refresh:
        folder = drive_find(drive_config_value("brainstorm_folder", "BrainstormAI"), "root", folder=True)
        cache = {"files": drive_list_json(folder["id"]) if folder else None}
        st.session_state["_brain_list"] = cache
    return cache["files"]


