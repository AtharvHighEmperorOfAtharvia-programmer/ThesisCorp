def save_training_db(topics, labels):
    if st.session_state.get("_training_unsynced"):
        st.warning(
            "The stored training database could not be read, so your changes are kept for this "
            "session only (the stored copy is protected from being overwritten)."
        )
        return

    payload = json.dumps({"topics": topics, "labels": labels}, indent=4, ensure_ascii=False)

    if drive_enabled():
        try:
            drive_upload(TRAINING_FILENAME, payload.encode("utf-8"), JSON_MIME, drive_folders()["root"])
            return
        except Exception as exc:
            st.warning(f"Could not save the training data to Google Drive ({drive_error(exc)}). Saved locally instead.")

    DATA_DIR.mkdir(parents=True, exist_ok=True)
    TRAINING_DATA_PATH.write_text(payload, encoding="utf-8")


def _read_training_file():
    """Parsed training JSON from Drive (if configured) or local storage; None if it doesn't exist yet."""
    if drive_enabled():
        found = drive_find(TRAINING_FILENAME, drive_folders()["root"])
        return json.loads(drive_download(found["id"]).decode("utf-8")) if found else None
    if TRAINING_DATA_PATH.exists():
        return json.loads(TRAINING_DATA_PATH.read_text(encoding="utf-8"))
    return None


def load_training_database():
    defaults = (list(DEFAULT_TOPICS), list(DEFAULT_LABELS))

    try:
        data = _read_training_file()
        if data is not None and not isinstance(data, dict):
            raise ValueError("unexpected file format")
    except Exception as exc:
        st.warning(
            f"Could not read the training database ({drive_error(exc)}). "
            "Using defaults for this session; the stored copy will not be overwritten."
        )
        st.session_state["_training_unsynced"] = True
        return defaults

    if data is not None:
        topics, labels = data.get("topics", []), data.get("labels", [])
        if topics and len(topics) == len(labels):
            return topics, labels
        if topics or labels:
            st.warning(
                "The training database is corrupted (topics and labels differ in length). "
                "Using defaults for this session; the stored copy will not be overwritten."
            )
            st.session_state["_training_unsynced"] = True
            return defaults

    # Missing or empty -> create it from the defaults
    save_training_db(*defaults)
    return defaults


def train_branch_model(topics, labels):
    if not topics or len(topics) != len(labels):
        raise ValueError("Training database is empty or corrupted. ClassGroot cannot be trained.")
    vectorizer = TfidfVectorizer()
    model = SGDClassifier(random_state=42)
    model.fit(vectorizer.fit_transform(topics), labels)
    return vectorizer, model


def get_classifier():
    if "clf" not in st.session_state:
        topics, labels = load_training_database()
        vectorizer, model = train_branch_model(topics, labels)
        st.session_state.clf = {
            "topics": topics, "labels": labels, "vec": vectorizer, "model": model,
        }
    return st.session_state.clf


def predict_branch(title):
    clf = get_classifier()
    return clf["model"].predict(clf["vec"].transform([title]))[0]


def add_training_examples(pairs):
    """Add (title, branch) pairs, save, and retrain. Returns how many were new."""
    clf = get_classifier()
    existing = set(zip(clf["topics"], clf["labels"]))
    added = 0
    for title, branch in pairs:
        title, branch = str(title).strip(), str(branch).strip().lower()
        if title and branch in BRANCHES and (title, branch) not in existing:
            clf["topics"].append(title)
            clf["labels"].append(branch)
            existing.add((title, branch))
            added += 1
    if added:
        save_training_db(clf["topics"], clf["labels"])
        clf["vec"], clf["model"] = train_branch_model(clf["topics"], clf["labels"])
    return added


def parse_training_batch(text):
    cleaned = re.sub(r"```(?:json)?", "", text).strip()
    start, end = cleaned.find("{"), cleaned.rfind("}")
    if start == -1 or end == -1:
        raise ValueError("The AI response did not contain JSON.")
    data = json.loads(cleaned[start:end + 1])

    rows = []
    for example in data.get("training_examples", []):
        title = str(example.get("title", "")).strip()
        branch = str(example.get("branch", "")).strip().lower()
        if title and branch in BRANCHES:
            rows.append({"keep": True, "title": title, "branch": branch})
    if not rows:
        raise ValueError("No valid training examples found in the AI response.")
    return pd.DataFrame(rows)


