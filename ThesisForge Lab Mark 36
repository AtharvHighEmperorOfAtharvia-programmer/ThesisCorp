def thesis_payload(sections):
    return {
        "thesisforge_version": VERSION,
        "sections": normalize_sections(copy.deepcopy(sections)),
    }


def parse_thesis(data):
    if not isinstance(data, dict) or "sections" not in data:
        raise ValueError("Invalid thesis file: missing 'sections'.")
    if not isinstance(data["sections"], dict):
        raise ValueError("Invalid thesis file: 'sections' must be a dictionary.")
    return normalize_sections(copy.deepcopy(data["sections"]))


def list_saved_theses(refresh=False):
    """[{'name': ..., 'id': Drive file id or None}] from Drive (if configured) or local storage."""
    if drive_enabled():
        cache = st.session_state.get("_thesis_list")
        if cache is None or refresh:
            cache = [
                {"name": f["name"], "id": f["id"]}
                for f in drive_list_json(drive_folders()["theses"])
            ]
            st.session_state["_thesis_list"] = cache
        return cache
    return [{"name": p.name, "id": None} for p in sorted(THESIS_DIR.glob("*.json"))]


def read_saved_thesis(name, file_id=None):
    if file_id:
        return json.loads(drive_download(file_id).decode("utf-8"))
    return json.loads((THESIS_DIR / name).read_text(encoding="utf-8"))


def save_thesis(sections, filename):
    """Save to Google Drive when configured, otherwise to local storage. Returns where it went."""
    filename = os.path.basename(filename.strip())
    if not filename:
        raise ValueError("Filename cannot be empty.")
    if not filename.lower().endswith(".json"):
        filename += ".json"

    payload = json.dumps(thesis_payload(sections), indent=4, ensure_ascii=False)

    if drive_enabled():
        drive_upload(filename, payload.encode("utf-8"), JSON_MIME, drive_folders()["theses"])
        st.session_state.pop("_thesis_list", None)
        return f"Google Drive → {drive_root_name()}/Theses/{filename}"

    path = THESIS_DIR / filename
    path.write_text(payload, encoding="utf-8")
    return f"local storage → {path}"


