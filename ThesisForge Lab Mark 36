    ids = st.session_state.get("_drive_ids")
    if not ids:
        root = drive_get_or_create_folder(drive_root_name())
        ids = {
            "root": root,
            "theses": drive_get_or_create_folder("Theses", root),
            "exports": drive_get_or_create_folder("Exports", root),
        }
        st.session_state["_drive_ids"] = ids
    return ids


def drive_upload(name, data, mime, parent):
    """Create the file, or overwrite the one with the same name in that folder."""
    media = MediaIoBaseUpload(io.BytesIO(data), mimetype=mime, resumable=False)
    files = drive_service().files()
    existing = drive_find(name, parent)
    if existing:
        return files.update(
            fileId=existing["id"], media_body=media, fields="id, name, webViewLink"
        ).execute()
    return files.create(
        body={"name": name, "parents": [parent]},
        media_body=media,
        fields="id, name, webViewLink",
    ).execute()


def drive_download(file_id):
    request = drive_service().files().get_media(fileId=file_id)
    buffer = io.BytesIO()
    downloader = MediaIoBaseDownload(buffer, request)
    done = False
    while not done:
        _, done = downloader.next_chunk()
    return buffer.getvalue()


def drive_list_json(parent):
    """All .json files directly inside a Drive folder."""
    files, token = [], None
    while True:
        result = drive_service().files().list(
            q=f"'{parent}' in parents and trashed = false and mimeType != '{FOLDER_MIME}'",
            spaces="drive",
            fields="nextPageToken, files(id, name, modifiedTime)",
            orderBy="name",
            pageSize=100,
            pageToken=token,
        ).execute()
        files += [f for f in result.get("files", []) if f["name"].lower().endswith(".json")]
        token = result.get("nextPageToken")
        if not token:
            return files


