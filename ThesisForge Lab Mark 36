        else:
            branch = branch_choice.lower()
            note = f"Branch set to **{branch.title()}**."
            if branch != predicted and add_training_examples([(title, branch)]):
                note += " Your correction was added to ClassGroot's training data."

        s.update(title=title, author=author, date=date, dominant_branch=branch, **values)
        flash("success", f"Changes applied. {note}")
