}


def build_docx(sections, style_name):
    cfg = EXPORT_STYLES[style_name]
    doc = Document()
    branch = (sections.get("dominant_branch") or "unknown").title()

    if cfg["layout"] == "blocks":
        doc.add_heading(cfg["top"], 0)
        for label, key in (("TITLE", "title"), ("AUTHOR", "author"), ("DATE", "date")):
            doc.add_heading(label, level=1)
            doc.add_paragraph(sections[key])
    else:
        if cfg["top"]:
            doc.add_heading(cfg["top"], 0)
            doc.add_paragraph(sections["title"])
        else:
            doc.add_heading(sections["title"], 0)
        doc.add_paragraph("Author: " + sections["author"])
        doc.add_paragraph("Date: " + sections["date"])

    doc.add_paragraph("Dominant Research Branch: " + branch)

    for key, heading in zip(SECTION_KEYS, cfg["headings"]):
        doc.add_heading(heading, level=1)
        doc.add_paragraph(sections[key])

    buffer = io.BytesIO()
    doc.save(buffer)
    return buffer.getvalue(), safe_filename(sections["title"], cfg["suffix"])


