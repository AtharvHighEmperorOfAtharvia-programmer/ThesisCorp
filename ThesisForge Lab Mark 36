def run_drive_token_helper():
    """One-time helper:  python app.py --get-drive-token   (run on your own computer)."""
    try:
        from google_auth_oauthlib.flow import InstalledAppFlow
    except ImportError:
        sys.exit("Install the helper first:  pip install google-auth-oauthlib")

    if not os.path.exists("client_secret.json"):
        sys.exit(
            "client_secret.json was not found next to app.py.\n"
            "Google Cloud Console -> APIs & Services -> Credentials -> Create credentials ->\n"
            "OAuth client ID -> Desktop app -> Download JSON, then save it as client_secret.json."
        )

    flow = InstalledAppFlow.from_client_secrets_file(
        "client_secret.json", ["https://www.googleapis.com/auth/drive"]
    )
    # access_type=offline + prompt=consent guarantees a refresh token is returned.
    creds = flow.run_local_server(port=0, access_type="offline", prompt="consent")
    if not creds.refresh_token:
        sys.exit(
            "Google did not return a refresh token. Remove the app's access at "
            "https://myaccount.google.com/permissions and run this again."
        )

    print("\n" + "=" * 60)
    print("Paste this into your Streamlit secrets (keep it private):")
    print("=" * 60)
    print("[gdrive]")
    print(f'client_id     = "{creds.client_id}"')
    print(f'client_secret = "{creds.client_secret}"')
    print(f'refresh_token = "{creds.refresh_token}"')
    print("=" * 60)


