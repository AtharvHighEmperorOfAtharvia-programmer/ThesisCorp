def get_drive_config():
    """The [gdrive] secrets as a dict, or None when Drive is not configured."""
    if not DRIVE_LIBS_OK:
        return None
    try:
        cfg = dict(st.secrets["gdrive"])
    except Exception:
        return None
    if not all(cfg.get(k) for k in ("client_id", "client_secret", "refresh_token")):
        return None
    return cfg


def drive_enabled():
    return get_drive_config() is not None


def drive_config_value(key, default):
    return (get_drive_config() or {}).get(key) or default


def drive_root_name():
    return drive_config_value("root_folder", "ThesisForge Lab")


def drive_service():
    """One Drive client per browser session (the HTTP client is not thread-safe)."""
    service = st.session_state.get("_drive_service")
    if service is None:
        cfg = get_drive_config()
        creds = Credentials(
            token=None,
            refresh_token=cfg["refresh_token"],
            token_uri="https://oauth2.googleapis.com/token",
            client_id=cfg["client_id"],
            client_secret=cfg["client_secret"],
            scopes=DRIVE_SCOPES,
        )
        service = build("drive", "v3", credentials=creds, cache_discovery=False)
        st.session_state["_drive_service"] = service
    return service


def drive_error(exc):
    """Friendly text for any exception raised while talking to Drive."""
    if DRIVE_LIBS_OK and isinstance(exc, RefreshError):
        return (
            "Google rejected the saved login (the refresh token expired or was revoked). "
            "Create a new refresh token with get_drive_token.py and update the secrets."
        )
    if DRIVE_LIBS_OK and isinstance(exc, HttpError):
        status = getattr(exc.resp, "status", "?")
        return f"Google Drive error (HTTP {status}): {getattr(exc, 'reason', None) or exc}"
    return str(exc)


def _q(value):
    """Escape a value for a Drive search query."""
    return value.replace("\\", "\\\\").replace("'", "\\'")


def drive_find(name, parent="root", folder=False):
    query = f"name = '{_q(name)}' and '{parent}' in parents and trashed = false"
    if folder:
        query += f" and mimeType = '{FOLDER_MIME}'"
    result = drive_service().files().list(
        q=query,
        spaces="drive",
        fields="files(id, name, modifiedTime)",
        orderBy="modifiedTime desc",
        pageSize=10,
    ).execute()
    files = result.get("files", [])
    return files[0] if files else None


def drive_get_or_create_folder(name, parent="root"):
    found = drive_find(name, parent, folder=True)
    if found:
        return found["id"]
    created = drive_service().files().create(
        body={"name": name, "mimeType": FOLDER_MIME, "parents": [parent]},
        fields="id",
    ).execute()
    return created["id"]


