# ---------- ClassGroot training (passcode protected) ----------

def add_manual_example():
    """Callback: add the typed training title with the branch the user confirmed."""
    title = st.session_state.get("train_title", "").strip()
    if not title:
        return
    predicted = predict_branch(title)
    branch = st.session_state.get(f"train_branch_{predicted}", predicted.title()).lower()
    if add_training_examples([(title, branch)]):
        flash("success", "Training example added to the database and ClassGroot retrained.")
    else:
        flash("info", "That example already exists in the database.")
    st.session_state["train_title"] = ""


def page_training():
    st.header("🔬 ClassGroot Training Station")

    # ----- passcode gate -----
    if not st.session_state.train_auth:
        if st.session_state.train_fails >= 3:
            st.error("Too many failed attempts. Training mode is locked for this session.")
            return
        with st.form("train_login"):
            code = st.text_input("Passcode", type="password")
            if st.form_submit_button("Unlock", type="primary"):
                expected = get_secret("SecurityPasscode")
                if expected and hmac.compare_digest(str(code).encode(), str(expected).encode()):
                    st.session_state.train_auth = True
                    st.rerun()
                else:
                    st.session_state.train_fails += 1
                    left = 3 - st.session_state.train_fails
                    st.error(f"Access denied. {left} attempt(s) left.")
        return

    # ----- authenticated -----
    clf = get_classifier()
    top = st.columns([4, 1])
    top[0].success("Access granted. Hello Dhruv. Welcome to the ClassGroot training station.")
    if top[1].button("🔒 Lock"):
        st.session_state.train_auth = False
        st.rerun()

    counts = pd.Series(clf["labels"]).value_counts()
    cols = st.columns(4)
    cols[0].metric("Total examples", len(clf["labels"]))
    for col, branch in zip(cols[1:], BRANCHES):
        col.metric(branch.title(), int(counts.get(branch, 0)))

    with st.expander("Prescribed workflow"):
        st.code(WORKFLOW_DIAGRAM, language=None)

    tab_ai, tab_manual, tab_test = st.tabs(["🤖 AI batch", "✍️ Add manually", "🧪 Test classifier"])

    with tab_ai:
        st.caption("Generate a batch, review it, untick anything wrong, fix branches, then add.")
        n = st.slider("Number of titles", 10, 100, 100, step=10)
        if st.button("Generate batch"):
            prompt = f"""
Generate {n} research titles.
For each, give the title and its primary branch:
biology, chemistry, or physics.
Include some cross-disciplinary titles.
Return only JSON:
{{"training_examples":[{{"title":"...","branch":"biology"}}]}}
"""
            with st.spinner("Generating training data..."):
                text = ask_ai(prompt)
            if text:
                try:
                    st.session_state.batch = parse_training_batch(text)
                except Exception as exc:
                    st.error(f"Could not read the AI's response: {exc}")
                    with st.expander("Raw response"):
                        st.code(text)

        if st.session_state.batch is not None:
            edited = st.data_editor(
                st.session_state.batch,
                key="batch_editor",
                hide_index=True,
                column_config={
                    "keep": st.column_config.CheckboxColumn("Keep", default=True),
                    "title": st.column_config.TextColumn("Title"),
                    "branch": st.column_config.SelectboxColumn("Branch", options=BRANCHES, required=True),
                },
            )
            c1, c2, _ = st.columns([2, 1, 3])
            if c1.button("✅ Add selected to database", type="primary"):
                chosen = edited[edited["keep"].fillna(False).astype(bool)]
                added = add_training_examples(zip(chosen["title"], chosen["branch"]))
                st.session_state.batch = None
                flash("success", f"Added {added} new example(s). ClassGroot retrained!")
                st.rerun()
            if c2.button("🗑️ Discard"):
                st.session_state.batch = None
                flash("info", "Training batch rejected.")
                st.rerun()

    with tab_manual:
        st.caption("Type a title, check ClassGroot's prediction, correct it if needed, then add it.")
        title = st.text_input("Training title", key="train_title")
        if title.strip():
            predicted = predict_branch(title)
            st.write("Predicted dominant branch:", f"**{predicted.title()}**")
            st.selectbox(
                "Correct branch",
                [b.title() for b in BRANCHES],
                index=BRANCHES.index(predicted),
                key=f"train_branch_{predicted}",
            )
            st.button("Add example", on_click=add_manual_example, type="primary")

    with tab_test:
        test_title = st.text_input("Type a research title to test")
        if test_title.strip():
            st.write("Predicted dominant branch:", f"**{predict_branch(test_title).title()}**")


