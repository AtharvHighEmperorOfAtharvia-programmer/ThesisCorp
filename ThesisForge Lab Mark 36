def get_secret(name, default=None):
    """Read from Streamlit secrets, falling back to environment variables."""
    try:
        return st.secrets[name]
    except Exception:
        return os.environ.get(name, default)


def flash(kind, message):
    """Show a message on the next run (survives st.rerun / callbacks)."""
    st.session_state.flash = (kind, message)


def show_flash():
    item = st.session_state.pop("flash", None)
    if item:
        getattr(st, item[0])(item[1])


def blank_sections():
    return normalize_sections({})


def normalize_sections(sections):
    """Make older ThesisForge JSON files compatible with this version."""
    defaults = {
        "title": "",
        "author": "",
        "date": "",
        "dominant_branch": "unknown",
        **{key: "" for key in SECTION_KEYS},
    }
    for key, default in defaults.items():
        if key not in sections or sections[key] is None:
            sections[key] = default
    return sections


def safe_filename(title, suffix="", ext=".docx"):
    name = re.sub(r'[<>:"/\\|?*]', "", title or "")
    name = re.sub(r"\s+", " ", name).strip().replace(" ", "_")
    return (name or "Research_Paper") + suffix + ext


def format_brainpad(pad):
    if isinstance(pad, (list, tuple)):
        return "\n".join(f"- {item}" for item in pad)
    if isinstance(pad, dict):
        return json.dumps(pad, indent=2, ensure_ascii=False)
    return str(pad)


